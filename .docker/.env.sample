# =============================================================================
# HoaTheoMua API Gateway - Local Development Environment
# Copy to `.env` (same folder) and fill in real values.
# =============================================================================

# Environment Configuration (maps to ASPNETCORE_ENVIRONMENT)
ENVIRONMENT=Development

# HTTP Configuration (host port published for the gateway container)
HTTP_PORT=8080

# JWT Configuration (maps to JwtOption)
JWT_ISSUER=JWT_ISSUER
JWT_AUDIENCE=JWT_AUDIENCE
JWT_SECRET=JWT_SECRET
JWT_EXPIRE_MIN=5

# Reverse proxy backend addresses (downstream service base URLs; override per environment)
ADDRESS_ECOMMERCE=http://hoatheomua-api-dev:8080/
ADDRESS_TASKCOPER=http://htm-taskcoper-api-dev:8080/

# Cloudflare Tunnel (public ingress for the gateway; leave empty for local)
CLOUDFLARE_TUNNEL_TOKEN=

# Docker Registry Configuration (for compose.yaml)
REGISTRY=localhost/hoatheomua
TAG=local
