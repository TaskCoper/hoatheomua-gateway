# Copy to <instance>.env; see README.md for the instance/token mapping.
# Use an exact release tag (YYYY.M.N) or, preferably, the digest currently running:
# cloudflare/cloudflared@sha256:<digest>
CLOUDFLARED_IMAGE=

# auto normally; http2 can be used when QUIC/UDP connectivity is unstable.
CLOUDFLARED_PROTOCOL=auto

# Keep the token for the EXISTING tunnel, from the matching repo/environment.
# Do not put this file in an application runner checkout or upload it to GitHub.
CLOUDFLARE_TUNNEL_TOKEN=
